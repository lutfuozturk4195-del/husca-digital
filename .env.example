# Copy to .env.local and fill in for local dev / deployment.

# Public site URL — used for canonical URLs, sitemap, JSON-LD, and llms.txt generation.
NEXT_PUBLIC_SITE_URL=https://huscadigital.com

# n8n (or any) webhook that receives Audit form submissions from /api/audit.
# Payload: { domain, email, source, submittedAt }
AUDIT_WEBHOOK_URL=https://your-n8n-instance.example.com/webhook/ai-visibility-audit

# Google Analytics 4 measurement ID. Loaded via @next/third-parties/google
# in components/SiteAnalytics.tsx — leave unset to skip GA4 entirely (it's
# optional; Vercel Web Analytics already runs regardless of this).
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# --- /admin (Traffic Dashboard + Blog CMS) ---

# Login password for /admin. Choose your own — this file is never committed.
ADMIN_PASSWORD=change-me

# Random secret used to sign the admin session cookie (HMAC-SHA256).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=replace-with-a-long-random-string

# Fine-grained GitHub PAT scoped ONLY to this repo, with Contents: Read and
# write permission. Required in production (Vercel's filesystem is
# read-only, so the CMS commits post changes via GitHub's Contents API
# instead of writing files directly) — optional in local dev, where the CMS
# writes straight to content/blog/*.md.
CMS_GITHUB_TOKEN=github_pat_...
# Defaults already point at this project's repo/branch — only set these if
# you fork or rename it.
# CMS_GITHUB_REPO=lutfuozturk4195-del/husca-digital
# CMS_GITHUB_BRANCH=main
